From 43b915fa109368ddc3147679bfcaa35d76bbc735 Mon Sep 17 00:00:00 2001
From: Olaf Hubert Bykowski <olafbykowski1@gmail.com>
Date: Mon, 30 Mar 2026 19:50:01 +0200
Subject: [PATCH 2/2] drivers: i2c: stm32: reinit I2C timing after PM resume on
 STM32WLx

---
 drivers/i2c/i2c_ll_stm32.c        |  4 ++++
 drivers/i2c/i2c_ll_stm32.h        |  3 +++
 drivers/i2c/i2c_ll_stm32_common.c | 16 ++++++++++++++++
 3 files changed, 23 insertions(+)

diff --git a/drivers/i2c/i2c_ll_stm32.c b/drivers/i2c/i2c_ll_stm32.c
index 966a953a061..56f20cd485a 100644
--- a/drivers/i2c/i2c_ll_stm32.c
+++ b/drivers/i2c/i2c_ll_stm32.c
@@ -122,6 +122,10 @@ int i2c_stm32_runtime_configure(const struct device *dev, uint32_t config)
 #endif
 	ret = i2c_stm32_configure_timing(dev, i2c_clock);
 
+#if defined(CONFIG_SOC_SERIES_STM32WLX)
+	data->i2c_clock = i2c_clock;
+#endif
+
 	if (data->smbalert_active) {
 		LL_I2C_Enable(i2c);
 	}
diff --git a/drivers/i2c/i2c_ll_stm32.h b/drivers/i2c/i2c_ll_stm32.h
index 2dfcea83af7..420881f7f68 100644
--- a/drivers/i2c/i2c_ll_stm32.h
+++ b/drivers/i2c/i2c_ll_stm32.h
@@ -94,6 +94,9 @@ struct i2c_stm32_data {
 #endif /* CONFIG_I2C_STM32_INTERRUPT */
 	struct k_sem bus_mutex;
 	uint32_t dev_config;
+#if defined(CONFIG_SOC_SERIES_STM32WLX)
+	uint32_t i2c_clock;
+#endif
 #if DT_HAS_COMPAT_STATUS_OKAY(st_stm32_i2c_v2)
 	/* Store the current timing structure set by runtime config */
 	struct i2c_config_timing current_timing;
diff --git a/drivers/i2c/i2c_ll_stm32_common.c b/drivers/i2c/i2c_ll_stm32_common.c
index e94ae5ec252..8cdbe219b75 100644
--- a/drivers/i2c/i2c_ll_stm32_common.c
+++ b/drivers/i2c/i2c_ll_stm32_common.c
@@ -92,6 +92,19 @@ int i2c_stm32_suspend(const struct device *dev)
 	return 0;
 }
 
+#if defined(CONFIG_SOC_SERIES_STM32WLX)
+static int i2c_stm32_reinit_timing(const struct device *dev)
+{
+	struct i2c_stm32_data *data = dev->data;
+	/* Initialize the clock to the previous state. */
+	int ret = i2c_stm32_configure_timing(dev, data->i2c_clock);
+	if (ret < 0) {
+		LOG_ERR("I2C timing configuration failed (%d)", ret);
+	}
+	return ret;
+}
+#endif
+
 int i2c_stm32_pm_action(const struct device *dev, enum pm_device_action action)
 {
 	int err;
@@ -99,6 +112,9 @@ int i2c_stm32_pm_action(const struct device *dev, enum pm_device_action action)
 	switch (action) {
 	case PM_DEVICE_ACTION_RESUME:
 		err = i2c_stm32_activate(dev);
+#if defined(CONFIG_SOC_SERIES_STM32WLX)
+		i2c_stm32_reinit_timing(dev);
+#endif
 		break;
 	case PM_DEVICE_ACTION_SUSPEND:
 		err = i2c_stm32_suspend(dev);
-- 
